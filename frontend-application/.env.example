# Local CyberChain SDK configuration. This file is ignored by Git.
# Paste hexadecimal key values only (no quotes and no 0x prefix).

RPC_URL=http://cyberchain-bc.bisite.es:8545
EXPECTED_SENDER_ADDRESS=

# Use "ec-dsa" for the first deployment experiment.
SIGN_MODE=ec-dsa

# Required for ECDSA signing. This is your ECDSA PRIVATE key.
ECDSA_PRIVATE_KEY=

# Required because this is the other half of your hybrid CyberChain address.
MLDSA_PUBLIC_KEY=
MLDSA_LEVEL=44

# Leave empty for ECDSA signing. Required only if SIGN_MODE=ml-dsa.
MLDSA_SECRET_KEY=
