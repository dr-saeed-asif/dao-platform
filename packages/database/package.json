{
  "name": "@dao-platform/database",
  "version": "0.1.0",
  "private": true,
  "description": "SQLite persistence adapters and migrations",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json --pretty false",
    "test": "npm run build && node --test dist/test/sqlite-proposal.repository.test.js",
    "db:migrate": "npm run build && node dist/scripts/migrate.js",
    "db:inspect": "npm run build && node dist/scripts/inspect.js"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dao-platform/application": "0.1.0",
    "@dao-platform/domain": "0.1.0",
    "better-sqlite3": "12.11.1",
    "kysely": "0.28.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "^24.0.0",
    "typescript": "^5.7.3"
  }
}
