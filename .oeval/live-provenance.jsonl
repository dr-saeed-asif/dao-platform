govai -d cybergovai\"]\n      interval: 5s","truncated":false,"loaded":[],"display":{"type":"file","path":"docker-compose.yml","text":"services:\n  postgres:\n    image: pgvector/pgvector:pg16\n    container_name: cybergovai-postgres\n    restart: unless-stopped\n\n    environment:\n      POSTGRES_DB: cybergovai\n      POSTGRES_USER: cybergovai\n      POSTGRES_PASSWORD: cybergovai_dev\n\n    ports:\n      - \"55432:5432\"\n\n    volumes:\n      - cybergovai_pgdata:/var/lib/postgresql/data\n\n    healthcheck:\n      test: [\"CMD-SHELL\", \"pg_isready -U cybergovai -d cybergovai\"]\n      interval: 5s\n      timeout: 5s\n      retries: 10\n\n  pgadmin:\n    image: dpage/pgadmin4:latest\n    container_name: cybergovai-pgadmin\n    restart: unless-stopped\n\n    environment:\n      PGADMIN_DEFAULT_EMAIL: [REDACTED_EMAIL]\n      PGADMIN_DEFAULT_PASSWORD: admin123\n\n    ports:\n      - \"5050:80\"\n\n    volumes:\n      - cybergovai_pgadmin:/var/lib/pgadmin\n\n    depends_on:\n      postgres:\n        condition: service_healthy\n\nvolumes:\n  cybergovai_pgdata:\n  cybergovai_pgadmin:","lineStart":1,"lineEnd":45,"totalLines":45,"truncated":false}}}}}
