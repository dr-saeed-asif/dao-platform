NODE_ENV=development
PORT=3000

DATABASE_URL=file:./data/dao.db

CYBERCHAIN_RPC_URL=
CYBERCHAIN_CHAIN_ID=
GOVERNANCE_CONTRACT_ADDRESS=
GOVERNANCE_DEPLOYMENT_BLOCK=0
VOTE_INDEXER_ENABLED=true
VOTE_INDEXER_INTERVAL_MS=30000
VOTE_INDEXER_BLOCK_RANGE=1000
DAO_ADMIN_ADDRESS=
DEV_AUTH_BYPASS_ENABLED=true

# Deployment-only secrets. Prefer a separate protected environment file.
SIGN_MODE=ec-dsa
ECDSA_PRIVATE_KEY=
MLDSA_PUBLIC_KEY=
MLDSA_LEVEL=44
MLDSA_SECRET_KEY=
EXPECTED_SENDER_ADDRESS=

JWT_SECRET=replace-with-a-long-development-secret

POSTGRES_URL=postgresql://cyberdao_dao_runtime:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:55432/cybergovai

# Nest proxies AI requests to api-ai-server. Models, agents, and RAG are configured there.
AI_SERVER_URL=http://127.0.0.1:8001
AI_SERVER_TOKEN=replace-with-the-api-ai-server-token
# DAO_IDENTITY_SIGNING_KEY is a private Ed25519 seed (64 hex characters, DAO API only).
# C6 relay origin. Production requires the exact HTTPS web origin.
RPC_WEB_ORIGIN=http://localhost:3001
