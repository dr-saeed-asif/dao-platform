NODE_ENV=development
PORT=3000

DATABASE_URL=file:./data/dao.db

CYBERCHAIN_RPC_URL=
CYBERCHAIN_CHAIN_ID=
GOVERNANCE_CONTRACT_ADDRESS=

# Deployment-only secrets. Prefer a separate protected environment file.
SIGN_MODE=ec-dsa
ECDSA_PRIVATE_KEY=
MLDSA_PUBLIC_KEY=
MLDSA_LEVEL=44
MLDSA_SECRET_KEY=
EXPECTED_SENDER_ADDRESS=

JWT_SECRET=replace-with-a-long-development-secret
