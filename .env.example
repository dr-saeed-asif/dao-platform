NODE_ENV=development
PORT=3000

DATABASE_URL=file:./data/dao.db

CYBERCHAIN_RPC_URL=
CYBERCHAIN_CHAIN_ID=
GOVERNANCE_CONTRACT_ADDRESS=
GOVERNANCE_DEPLOYMENT_BLOCK=0
VOTE_INDEXER_ENABLED=true
VOTE_INDEXER_INTERVAL_MS=30000
VOTE_INDEXER_BLOCK_RANGE=1000
DAO_ADMIN_ADDRESS=
DEV_AUTH_BYPASS_ENABLED=true

# Deployment-only secrets. Prefer a separate protected environment file.
SIGN_MODE=ec-dsa
ECDSA_PRIVATE_KEY=
MLDSA_PUBLIC_KEY=
MLDSA_LEVEL=44
MLDSA_SECRET_KEY=
EXPECTED_SENDER_ADDRESS=

JWT_SECRET=replace-with-a-long-development-secret

POSTGRES_URL=postgresql://user:pass@localhost:5432/db

IS_ACTIVE=false
AI_LLM_PROVIDER=

GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_LLM_MODEL=openai/gpt-oss-20b

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
OLLAMA_EMBED_DIMENSION=1024
