{
  "info": {
    "name": "DAO Platform - Proposal Workflow",
    "description": "Development proposal persistence and CyberChain transaction preparation workflow.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/v1" },
    {
      "key": "adminAddress",
      "value": "0xb8163f7d6d404f67a400743b90f7952d2d137b8e"
    },
    { "key": "proposalId", "value": "" },
    {
      "key": "memberAddress",
      "value": "0xb8163f7d6d404f67a400743b90f7952d2d137b8e"
    },
    { "key": "voteTransactionHash", "value": "" }
  ],
  "item": [
    {
      "name": "1 - Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "2 - Create proposal draft and prepare transaction",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "exec": [
              "const startsAt = new Date(Date.now() + 5 * 60 * 1000);",
              "const endsAt = new Date(startsAt.getTime() + 60 * 60 * 1000);",
              "pm.collectionVariables.set('startsAt', startsAt.toISOString());",
              "pm.collectionVariables.set('endsAt', endsAt.toISOString());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "exec": [
              "const response = pm.response.json();",
              "pm.collectionVariables.set('proposalId', response.proposal.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "idempotency-key",
            "value": "postman-{{$guid}}"
          },
          {
            "key": "x-wallet-address",
            "value": "{{adminAddress}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"daoId\": \"cyber-dao\",\n  \"title\": \"Fund a security audit\",\n  \"purpose\": \"Improve DAO contract safety\",\n  \"description\": \"Approve funding for an independent audit of the DAO contracts.\",\n  \"type\": \"TREASURY\",\n  \"optionLabels\": [\"Approve\", \"Reject\", \"Abstain\"],\n  \"startsAt\": \"{{startsAt}}\",\n  \"endsAt\": \"{{endsAt}}\",\n  \"metadataURI\": \"ipfs://replace-with-real-cid\",\n  \"metadataHash\": \"0xaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa\"\n}"
        },
        "url": "{{baseUrl}}/proposals"
      }
    },
    {
      "name": "3 - List proposals",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/proposals?limit=20&offset=0"
      }
    },
    {
      "name": "4 - Get created proposal",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/proposals/{{proposalId}}"
      }
    },
    {
      "name": "5 - Publish proposal on-chain",
      "request": {
        "method": "POST",
        "header": [{ "key": "x-wallet-address", "value": "{{adminAddress}}" }],
        "url": "{{baseUrl}}/proposals/{{proposalId}}/publish"
      }
    },
    {
      "name": "6 - Assign member on-chain",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-wallet-address", "value": "{{adminAddress}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"memberAddresses\": [\"{{memberAddress}}\"]\n}"
        },
        "url": "{{baseUrl}}/proposals/{{proposalId}}/members"
      }
    },
    {
      "name": "7 - List assigned members from SQLite",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/proposals/{{proposalId}}/members"
      }
    },
    {
      "name": "8 - Prepare member vote for wallet signing",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-wallet-address", "value": "{{memberAddress}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"optionIndex\": 0\n}" },
        "url": "{{baseUrl}}/proposals/{{proposalId}}/votes/prepare"
      }
    },
    {
      "name": "9 - Confirm wallet-submitted vote",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-wallet-address", "value": "{{memberAddress}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"transactionHash\": \"{{voteTransactionHash}}\"\n}"
        },
        "url": "{{baseUrl}}/proposals/{{proposalId}}/votes/confirm"
      }
    },
    {
      "name": "10 - List indexed votes from SQLite",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/proposals/{{proposalId}}/votes"
      }
    },
    {
      "name": "11 - Manually synchronize vote events",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-wallet-address", "value": "{{adminAddress}}" }
        ],
        "body": { "mode": "raw", "raw": "{\n  \"full\": false\n}" },
        "url": "{{baseUrl}}/proposals/sync/votes"
      }
    },
    {
      "name": "12 - Unassign member on-chain (before voting starts only)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "x-wallet-address", "value": "{{adminAddress}}" }],
        "url": "{{baseUrl}}/proposals/{{proposalId}}/members/{{memberAddress}}"
      }
    }
  ]
}
